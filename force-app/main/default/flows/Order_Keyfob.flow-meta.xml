        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>case_description</name>
        <dataType>String</dataType>
        <expression>&quot;Request &quot; &amp; {!request_id} &amp; &quot;. SmartRent order &quot; &amp; {!order_response.orderId} &amp; &quot;. Price 75 USD.&quot;</expression>
    </formulas>
    <formulas>
        <name>has_contact_id</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!contact_id}))</expression>
    </formulas>
    <formulas>
        <name>has_recent_order</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Find_Recent_Order.Id}))</expression>
    </formulas>
    <formulas>
        <name>request_id</name>
        <dataType>String</dataType>
        <expression>{!$Flow.InterviewGuid}</expression>
    </formulas>
    <formulas>
        <name>response_was_201</name>
        <dataType>Boolean</dataType>
        <expression>{!response_code} = 201</expression>
    </formulas>
    <formulas>
        <name>tenant_may_order</name>
        <dataType>Boolean</dataType>
        <expression>AND({!is_active_tenant}, LEN({!apartment_id}) &gt; 0, LEN({!account_id}) &gt; 0)</expression>
    </formulas>
