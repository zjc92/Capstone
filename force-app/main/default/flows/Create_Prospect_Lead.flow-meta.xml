    <description>Creates a leasing Lead only after the guest gives a last name, an email or phone number, and explicit consent to follow up.</description>
    <formulas>
        <name>session_id_present</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!messaging_session_id}))</expression>
    </formulas>
    <formulas>
        <name>lead_notes</name>
        <dataType>String</dataType>
        <expression>&quot;Website leasing assistant. City: &quot; &amp; BLANKVALUE({!city}, &quot;not given&quot;) &amp; &quot;. Bedrooms: &quot; &amp; BLANKVALUE({!bedrooms}, &quot;not given&quot;) &amp; &quot;. Max rent: &quot; &amp; BLANKVALUE({!max_rent}, &quot;not given&quot;) &amp; &quot;. Notes: &quot; &amp; BLANKVALUE({!notes}, &quot;none&quot;) &amp; &quot;. Guest consented to follow-up.&quot;</expression>
    </formulas>
    <formulas>
        <name>ready_to_create</name>
        <dataType>Boolean</dataType>
        <expression>AND({!consent}, NOT(ISBLANK({!last_name})), OR(NOT(ISBLANK({!email})), NOT(ISBLANK({!phone}))))</expression>
    </formulas>
