<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <accessType>NamespaceRestricted</accessType>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Article</name>
        <label>Add Article</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>articles</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>article_block</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>article_count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Article</targetReference>
        </connector>
    </assignments>
    <description>Returns the title, question, and answer of every published English Knowledge article visible to authenticated customers (the resident articles). Runs in system mode so a signed-in portal resident gets the same text the agent user would.</description>
    <environments>Default</environments>
    <formulas>
        <name>article_block</name>
        <dataType>String</dataType>
        <expression>&quot;Article: &quot; &amp; {!Each_Article.Title} &amp; BR() &amp; &quot;Question: &quot; &amp; {!Each_Article.Question__c} &amp; BR() &amp; &quot;Answer: &quot; &amp; {!Each_Article.Answer__c} &amp; BR() &amp; BR()</expression>
    </formulas>
    <interviewLabel>Get Resident Articles {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Resident Articles</label>
    <loops>
        <name>Each_Article</name>
        <label>Each Article</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Find_Resident_Articles</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Article</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_Resident_Articles</name>
        <label>Find Resident Articles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Each_Article</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <filters>
            <field>Language</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>en_US</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsVisibleInCsp</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Knowledge__kav</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Title</queriedFields>
        <queriedFields>Question__c</queriedFields>
        <queriedFields>Answer__c</queriedFields>
        <sortField>Title</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Resident_Articles</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>article_count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>articles</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>unused</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
