    <description>Returns at most three vacant apartments for a city and bedroom count. Maximum rent is optional. move_in_window this_week limits available dates to the current Monday through Sunday. Does not create a lead or apply a discount.</description>
    <formulas>
        <name>bedrooms_number</name>
        <dataType>Number</dataType>
        <expression>VALUE({!bedrooms})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>city_match</name>
        <dataType>String</dataType>
        <expression>CASE(LOWER(TRIM({!city})), &quot;portland&quot;, &quot;Portland&quot;, &quot;seattle&quot;, &quot;Seattle&quot;, &quot;san francisco&quot;, &quot;San Francisco&quot;, &quot;sf&quot;, &quot;San Francisco&quot;, TRIM({!city}))</expression>
    </formulas>
    <formulas>
        <name>is_this_week</name>
        <dataType>Boolean</dataType>
        <expression>LOWER(TRIM({!move_in_window})) = &quot;this_week&quot;</expression>
    </formulas>
    <formulas>
        <name>max_rent_amount</name>
        <dataType>Currency</dataType>
        <expression>VALUE({!max_rent})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>row_line</name>
        <dataType>String</dataType>
        <expression>BR() &amp; {!Loop_Matches.Name} &amp; &quot; | &quot; &amp; BLANKVALUE({!Get_Location.Name}, &quot;Unknown building&quot;) &amp; &quot; | $&quot; &amp; TEXT({!Loop_Matches.Rent__c}) &amp; &quot; | &quot; &amp; TEXT({!Loop_Matches.Bedrooms__c}) &amp; &quot; bed | &quot; &amp; BLANKVALUE({!amenities_text}, &quot;none listed&quot;) &amp; &quot; | available &quot; &amp; TEXT({!Loop_Matches.Available_Date__c})</expression>
    </formulas>
    <formulas>
        <name>week_end</name>
        <dataType>Date</dataType>
        <expression>{!week_start} + 6</expression>
    </formulas>
    <formulas>
        <name>week_start</name>
        <dataType>Date</dataType>
        <expression>TODAY() - CASE(WEEKDAY(TODAY()), 1, 6, 2, 0, 3, 1, 4, 2, 5, 3, 6, 4, 7, 5, 0)</expression>
    </formulas>
