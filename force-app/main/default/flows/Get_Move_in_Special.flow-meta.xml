    <description>Returns the move-in special on file for a vacant apartment this month. The listed Rent Discount is the ceiling. No row means no discount.</description>
    <formulas>
        <name>allowed_line</name>
        <dataType>String</dataType>
        <expression>BR() &amp; {!Loop_Apartments.Name} &amp; &quot; | &quot; &amp; BLANKVALUE({!Get_Location.Name}, &quot;Unknown building&quot;) &amp; &quot; | listed rent $&quot; &amp; TEXT({!Loop_Apartments.Rent__c}) &amp; &quot; | listed special $&quot; &amp; TEXT({!Get_Special.Rent_Discount__c}) &amp; &quot; off for &quot; &amp; TEXT({!Get_Special.Number_of_Months__c}) &amp; &quot; month. A discount of $&quot; &amp; TEXT({!requested_amount}) &amp; &quot; is within that special and can be offered.&quot;</expression>
    </formulas>
    <formulas>
        <name>bedrooms_number</name>
        <dataType>Number</dataType>
        <expression>VALUE({!bedrooms})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>city_match</name>
        <dataType>String</dataType>
        <expression>CASE(LOWER(TRIM({!city})), &quot;portland&quot;, &quot;Portland&quot;, &quot;seattle&quot;, &quot;Seattle&quot;, &quot;san francisco&quot;, &quot;San Francisco&quot;, &quot;sf&quot;, &quot;San Francisco&quot;, TRIM({!city}))</expression>
    </formulas>
    <formulas>
        <name>current_month</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH(TODAY()), 1, &quot;January&quot;, 2, &quot;February&quot;, 3, &quot;March&quot;, 4, &quot;April&quot;, 5, &quot;May&quot;, 6, &quot;June&quot;, 7, &quot;July&quot;, 8, &quot;August&quot;, 9, &quot;September&quot;, 10, &quot;October&quot;, 11, &quot;November&quot;, &quot;December&quot;)</expression>
    </formulas>
    <formulas>
        <name>current_year</name>
        <dataType>Number</dataType>
        <expression>YEAR(TODAY())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>listed_rent_amount</name>
        <dataType>Currency</dataType>
        <expression>VALUE({!listed_rent})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>none_line</name>
        <dataType>String</dataType>
        <expression>BR() &amp; {!Loop_Apartments.Name} &amp; &quot; | &quot; &amp; BLANKVALUE({!Get_Location.Name}, &quot;Unknown building&quot;) &amp; &quot; | listed rent $&quot; &amp; TEXT({!Loop_Apartments.Rent__c}) &amp; &quot; | no move-in special is on file for this month. No discount can be offered.&quot;</expression>
    </formulas>
    <formulas>
        <name>refused_line</name>
        <dataType>String</dataType>
        <expression>BR() &amp; {!Loop_Apartments.Name} &amp; &quot; | &quot; &amp; BLANKVALUE({!Get_Location.Name}, &quot;Unknown building&quot;) &amp; &quot; | listed rent $&quot; &amp; TEXT({!Loop_Apartments.Rent__c}) &amp; &quot; | listed special $&quot; &amp; TEXT({!Get_Special.Rent_Discount__c}) &amp; &quot; off for &quot; &amp; TEXT({!Get_Special.Number_of_Months__c}) &amp; &quot; month. A discount of $&quot; &amp; TEXT({!requested_amount}) &amp; &quot; is above that ceiling and cannot be offered.&quot;</expression>
    </formulas>
    <formulas>
        <name>requested_amount</name>
        <dataType>Currency</dataType>
        <expression>VALUE({!requested_discount})</expression>
        <scale>0</scale>
    </formulas>
