    <description>Creates a maintenance Case for a verified active tenant. The apartment and account come from Verify_Active_Tenant. Priority and the 365-day replacement count are set here.</description>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>apartment_id_present</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!apartment_id}) &gt; 0</expression>
    </formulas>
    <formulas>
        <name>has_contact_id</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!contact_id}))</expression>
    </formulas>
    <formulas>
        <name>has_owner_id</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!case_owner_id}))</expression>
    </formulas>
    <formulas>
        <name>one_year_ago</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - 365</expression>
    </formulas>
    <formulas>
        <name>replacement_due</name>
        <dataType>Boolean</dataType>
        <expression>{!closed_case_count} &gt; 3</expression>
    </formulas>
    <formulas>
        <name>session_id_present</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(LEN({!messaging_session_id})=15, LEN({!messaging_session_id})=18), REGEX({!messaging_session_id}, &quot;^[a-zA-Z0-9]+$&quot;))</expression>
    </formulas>
