    <description>Returns occupied apartments for this messaging session. result is the apartment count. When result is 1, default_apartment_id is that record's Id. When the latest message names exactly one of those apartments, default_apartment_id is that record's Id. contact_id is the session EndUserContactId when the session has an account. person_email is that account's PersonEmail.</description>
    <formulas>
        <name>session_id_present</name>
        <dataType>Boolean</dataType>
        <expression>AND(OR(LEN({!messaging_session_id})=15, LEN({!messaging_session_id})=18), REGEX({!messaging_session_id}, &quot;^[a-zA-Z0-9]+$&quot;))</expression>
    </formulas>
    <formulas>
        <name>next_choice_list</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!apartment_choices}), {!Use_The_Apartment.Name}, {!apartment_choices} &amp; BR() &amp; {!Use_The_Apartment.Name})</expression>
    </formulas>
    <formulas>
        <name>keep_first_id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!first_apartment_id}), {!Use_The_Apartment.Id}, {!first_apartment_id})</expression>
    </formulas>
    <formulas>
        <name>keep_first_name</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!first_apartment_name}), {!Use_The_Apartment.Name}, {!first_apartment_name})</expression>
    </formulas>
    <formulas>
        <name>next_match_count</name>
        <dataType>Number</dataType>
        <expression>{!match_count} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>utterance_names_this_apartment</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!resident_message})), NOT(ISBLANK({!Use_The_Apartment.Name})), OR(CONTAINS(LOWER({!resident_message}), LOWER({!Use_The_Apartment.Name})), AND(CONTAINS({!Use_The_Apartment.Name}, &quot; - &quot;), CONTAINS(LOWER({!resident_message}), LOWER(LEFT({!Use_The_Apartment.Name}, FIND(&quot; - &quot;, {!Use_The_Apartment.Name}) - 1))))))</expression>
    </formulas>
