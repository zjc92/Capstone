    <description>Inbound Omni-Channel flow. Sends a signed-in resident Enhanced Chat session to Tenant Concierge. If the agent cannot take it, the session waits in Resident Concierge. A verified session (platform key AUTH/SFDC/uid:) is linked to that portal user's contact and account first, so the session's EndUserAccountId is set.</description>
    <environments>Default</environments>
    <formulas>
        <name>signed_in_user_id</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Get_End_User.MessagingPlatformKey}, &quot;/AUTH/SFDC/uid:&quot;), TRIM(MID({!Get_End_User.MessagingPlatformKey}, FIND(&quot;uid:&quot;, {!Get_End_User.MessagingPlatformKey}) + 4, 18)), &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Route Resident Inbound {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Route Resident Inbound</label>
