    <description>Counts this manager's buildings, occupancy, payments due in the last 7 days, and cases. Not an agent action. Does not call Agentforce.</description>
    <environments>Default</environments>
    <formulas>
        <name>occupancy_value</name>
        <dataType>Number</dataType>
        <expression>IF({!apartment_count} = 0, 0, {!occupied_count} / {!apartment_count} * 100)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>vacant_value</name>
        <dataType>Number</dataType>
        <expression>{!apartment_count} - {!occupied_count}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>today_date</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>week_start</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 7</expression>
    </formulas>
    <formulas>
        <name>week_start_time</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
    <interviewLabel>Summarize Manager Week {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Summarize Manager Week</label>
