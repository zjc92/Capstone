    <description>Counts past-due payments for one tenant inside the supplied manager's buildings and returns the renewal decision. Not an agent action.</description>
    <environments>Default</environments>
    <formulas>
        <name>decision_value</name>
        <dataType>String</dataType>
        <expression>IF({!past_due_count} &gt; 3, &quot;Decline&quot;, IF({!past_due_count} = 0, &quot;StandardRenewal&quot;, IF(AND({!is_oregon}, {!in_first_year}), &quot;RenewalNoIncrease&quot;, &quot;RenewalIncrease&quot;)))</expression>
    </formulas>
    <formulas>
        <name>in_first_year</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!earliest_due})), {!earliest_due} &gt;= (TODAY() - 365))</expression>
    </formulas>
    <formulas>
        <name>increase_value</name>
        <dataType>Number</dataType>
        <expression>IF({!decision_value} = &quot;RenewalIncrease&quot;, 10, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>is_oregon</name>
        <dataType>Boolean</dataType>
        <expression>{!city} = &quot;Portland&quot;</expression>
    </formulas>
    <formulas>
        <name>case_line</name>
        <dataType>String</dataType>
        <expression>{!Each_Case.CaseNumber} &amp; &quot; | &quot; &amp; {!Each_Case.Subject} &amp; &quot; | &quot; &amp; TEXT({!Each_Case.Status}) &amp; &quot; | &quot; &amp; TEXT(DATEVALUE({!Each_Case.CreatedDate}))</expression>
    </formulas>
    <formulas>
        <name>next_case_table</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!case_table}), {!case_line}, {!case_table} &amp; &quot;; &quot; &amp; {!case_line})</expression>
    </formulas>
    <formulas>
        <name>next_subjects</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Each_Case.Subject}), {!case_subjects}, IF(ISBLANK({!case_subjects}), {!Each_Case.Subject}, {!case_subjects} &amp; &quot;; &quot; &amp; {!Each_Case.Subject}))</expression>
    </formulas>
    <formulas>
        <name>notice_value</name>
        <dataType>Number</dataType>
        <expression>IF({!decision_value} = &quot;RenewalNoIncrease&quot;, 90, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>tone_value</name>
        <dataType>String</dataType>
        <expression>IF({!decision_value} = &quot;Decline&quot;, &quot;decline&quot;, IF({!decision_value} = &quot;StandardRenewal&quot;, &quot;warm&quot;, &quot;strict&quot;))</expression>
    </formulas>
