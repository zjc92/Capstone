    {
      "components": [
        {
          "componentAttributes": {
            "richTextValue": "<div class='ph-hero'><div class='ph-hero-text'><span class='ph-eyebrow'>PREMIUM APARTMENTS &middot; WEST COAST</span><h1>Find a place that feels like home.</h1><p class='ph-sub'>Pacific Haven manages 51 buildings and 1,498 apartments in San Francisco, Portland, and Seattle.</p></div></div>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "6df8e08b-cb6a-419c-bfc9-59e242b87357",
          "renderPriority": "NEUTRAL",
          "renditionMap": {},
          "type": "component"
        },
        {
          "componentAttributes": {
            "richTextValue": "<div class='ph-section'><h2>Your leasing assistant, available any time</h2><p class='ph-lead'>Ask about available apartments, current move-in specials, or our community policies. If you would like to talk to a person, we will connect you with a leasing specialist.</p><div class='ph-grid'><div class='ph-card'><span class='ph-num'>1</span><h3>Find an apartment</h3><p>Tell us the city, bedrooms and budget, and see what is available now.</p></div><div class='ph-card teal'><span class='ph-num'>2</span><h3>See move-in specials</h3><p>Check the current special for the apartment you like.</p></div><div class='ph-card indigo'><span class='ph-num'>3</span><h3>Meet a specialist</h3><p>Leave your details and a leasing specialist will follow up.</p></div></div></div>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "74f3fce4-f4e5-42f0-ac50-cffba4f5be94",
          "renderPriority": "NEUTRAL",
          "renditionMap": {},
          "type": "component"
        },
        {
          "componentAttributes": {
            "richTextValue": "<div class='ph-section ph-cities'><h2>Three great cities</h2><p class='ph-lead'>Homes in the neighborhoods people love.</p><div class='ph-grid'><div class='ph-card'><h3>San Francisco</h3><p>Bright apartments close to everything the city offers.</p></div><div class='ph-card teal'><h3>Portland</h3><p>Relaxed, green neighborhoods with easy access to downtown.</p></div><div class='ph-card indigo'><h3>Seattle</h3><p>Modern buildings from the waterfront to the university district.</p></div></div></div>"
          },
