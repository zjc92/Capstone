/**
 * Builds the weekly building summary as a PDF file and returns its download link.
 * Called by the Weekly_Property_Summary flow with the numbers that flow already computed
 * for the running manager. It does no query on buildings, so it cannot widen the scope.
 * The file is created by the running user and is not linked to any record, so only that
 * user can open it.
 */
public with sharing class WeeklySummaryPdf {

    public class Request {
        @InvocableVariable public String managerUserId;
        @InvocableVariable public Decimal buildingCount;
        @InvocableVariable public Decimal apartmentCount;
        @InvocableVariable public Decimal occupiedCount;
        @InvocableVariable public Decimal vacantCount;
        @InvocableVariable public Decimal occupancyRate;
        @InvocableVariable public Decimal paymentsDueCount;
        @InvocableVariable public Decimal latePaymentCount;
        @InvocableVariable public Decimal lateRentTotal;
        @InvocableVariable public Decimal casesOpenedCount;
        @InvocableVariable public Decimal casesOpenCount;
        @InvocableVariable public Decimal casesClosedCount;
    }

    public class Result {
        @InvocableVariable public String fileUrl;
        @InvocableVariable public String fileName;
    }

    @InvocableMethod(label='Create Weekly Summary PDF' description='Saves the weekly building summary as a PDF file owned by the running user and returns the download link.')
    public static List<Result> create(List<Request> requests) {
        List<Result> out = new List<Result>();
        for (Request r : requests) {
            Result res = new Result();
            try {
                build(r, res);
            } catch (Exception e) {
                res.fileUrl = '';
                res.fileName = '';
            }
            out.add(res);
        }
        return out;
    }

    private static void build(Request r, Result res) {
        Id managerId = String.isBlank(r.managerUserId) ? UserInfo.getUserId() : (Id) r.managerUserId;
        String managerName = [SELECT Name FROM User WHERE Id = :managerId LIMIT 1].Name;
        Date today = Date.today();
        Date from7 = today.addDays(-7);

        String html = '<html><body style="font-family: Arial, sans-serif; font-size: 12px;">'
            + '<h1 style="font-size: 20px;">Weekly property summary</h1>'
            + '<p>Property manager: <b>' + esc(managerName) + '</b><br/>'
            + 'Period: ' + from7.format() + ' to ' + today.format() + ' (last 7 days)</p>'
            + '<table style="border-collapse: collapse; width: 100%;">'
            + '<tr><th align="left" style="border: 1px solid #999; padding: 4px;">Measure</th>'
            + '<th align="right" style="border: 1px solid #999; padding: 4px;">Value</th>'
            + '<th align="left" style="border: 1px solid #999; padding: 4px;">What it counts</th></tr>'
            + row('Buildings', num(r.buildingCount), 'Buildings assigned to you')
            + row('Apartments', num(r.apartmentCount), 'Apartments in those buildings')
            + row('Occupied', num(r.occupiedCount), 'Occupied apartments')
            + row('Vacant', num(r.vacantCount), 'Vacant apartments')
            + row('Occupancy rate', rate(r.occupancyRate), 'Occupied divided by apartments')
            + row('Payments due', num(r.paymentsDueCount), 'Payments due in the last 7 days')
            + row('Late payments', num(r.latePaymentCount), 'Past-due payments in that window')
            + row('Late rent total', money(r.lateRentTotal), 'Rent amount on those late payments')
            + row('Cases opened', num(r.casesOpenedCount), 'Cases opened in the last 7 days')
            + row('Cases still open', num(r.casesOpenCount), 'Cases still open')
            + row('Cases closed', num(r.casesClosedCount), 'Cases closed in the last 7 days')
            + '</table>'
            + '<p style="color: #555; margin-top: 16px;">Generated by Ops Copilot on ' + today.format()
            + ' from Apartment, Lease Payment and Case records in your buildings only.</p>'
            + '</body></html>';

        String fileName = 'Weekly summary ' + managerName + ' ' + String.valueOf(today) + '.pdf';
        ContentVersion cv = new ContentVersion(
            Title = fileName.removeEnd('.pdf'),
            PathOnClient = fileName,
            VersionData = Blob.toPdf(html)
        );
        insert cv;
        Id docId = [SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id LIMIT 1].ContentDocumentId;
        res.fileName = fileName;
        res.fileUrl = URL.getOrgDomainUrl().toExternalForm() + '/sfc/servlet.shepherd/document/download/' + docId;
    }

    private static String row(String a, String b, String c) {
        return '<tr><td style="border: 1px solid #999; padding: 4px;">' + a + '</td>'
            + '<td align="right" style="border: 1px solid #999; padding: 4px;">' + b + '</td>'
            + '<td style="border: 1px solid #999; padding: 4px;">' + c + '</td></tr>';
    }

    private static String num(Decimal d) {
        return d == null ? '0' : String.valueOf(d.setScale(0));
    }

    private static String rate(Decimal d) {
        return (d == null ? 0 : d).setScale(1) + '%';
    }

    private static String money(Decimal d) {
        return '$' + (d == null ? 0 : d).setScale(2).format();
    }

    private static String esc(String s) {
        return s == null ? '' : s.escapeHtml4();
    }
}
