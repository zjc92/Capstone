            <expectedValue>Answers from a resident article and names that article. Asks whether the resident wants a maintenance request filed. It does not say a case was created.</expectedValue>
            <name>bot_response_rating</name>
        </expectation>
        <inputs>
            <utterance>My faucet is leaking</utterance>
            <contextVariable>
                <variableName>session_id</variableName>
                <variableValue>0MwVW000007c1Or0AI</variableValue>
            </contextVariable>
